{
  "manifest_version": 3,
  "name": "Pefl LS Extension",
  "version": "0.1.0",
  "description": "Boilerplate Chrome extension built with Vite and plain JavaScript.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pefl LS"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": []
}
